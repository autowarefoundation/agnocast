<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>agnocast_cuda</name>
  <version>2.3.5</version>
  <description>
    CUDA IPC support for Agnocast. Provides GPU message types and cross-process GPU buffer sharing.
  </description>
  <maintainer email="sykwer@gmail.com">Takahiro Ishikawa-Aso</maintainer>
  <maintainer email="koichi.imai.2@tier4.jp">Koichi Imai</maintainer>
  <maintainer email="masaki.nishikawa@tier4.jp">Masaki Nishikawa</maintainer>
  <license>Apache License 2.0</license>

  <!-- Original authors -->
  <author email="sykwer@gmail.com">Takahiro Ishikawa-Aso</author>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <depend>agnocastlib</depend>
  <depend>agnocast_gpu_shared_memory_daemon</depend>
  <depend>sensor_msgs</depend>

  <test_depend>ament_cmake_gmock</test_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
